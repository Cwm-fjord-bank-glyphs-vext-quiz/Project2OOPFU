import java.time.localdate
import java.util.List;

// Does all the calculations on a list of records (sorted by date, not empty)
class RecordCalculator {
   private final List<DayRecordStock> records;

   public RecordCalculator(List<DayRecordStock> records) {
       if (records.isEmpty()) {
           throw new IllegalArgumentException("Cannot analyze an empty period.");
       }
       this.records = records;
   }

   public double getHighestClose() {
       double max = records.get(0).getClose();
       for (DayRecordStock r : records) {
           if (r.getClose() > max) {
               max = r.getClose();
           }
       }
       return max;
   }

   public double getLowestClose() {
       double min = records.get(0).getClose();
       for (DayRecordStock r : records) {
           if (r.getClose() < min) {
               min = r.getClose();
           }
       }
       return min;
   }

   public double getAverageClose() {
       double sum = 0;
       for (DayRecordStock r : records) {
           sum += r.getClose();
       }
       return sum / records.size();
   }

   // First close in the period to last close in the period
   public double getPercentChange() {
       double first = records.get(0).getClose();
       double last = records.get(records.size() - 1).getClose();
       return (last - first) / first * 100.0;
   }

   public double getAverageVolume() {
       double sum = 0;
       for (DayRecordStock r : records) {
           sum += r.getVolume();
       }
       return sum / records.size();
   }

   // Largest day-over-day percentage increase; null if there is only one day
   public DayChange getBestDay() {
       DayChange best = null;
       for (int i = 1; i < records.size(); i++) {
           DayChange change = changeOnDay(i);
           if (best == null || change.getPercent() > best.getPercent()) {
               best = change;
           }
       }
       return best;
   }

   // Largest day-over-day percentage decrease; null if there is only one day
   public DayChange getWorstDay() {
       DayChange worst = null;
       for (int i = 1; i < records.size(); i++) {
           DayChange change = changeOnDay(i);
           if (worst == null || change.getPercent() < worst.getPercent()) {
               worst = change;
           }
       }
       return worst;
   }

   // Today's close compared with the previous trading day's close
   private DayChange changeOnDay(int i) {
       double previous = records.get(i - 1).getClose();
       double current = records.get(i).getClose();
       return new DayChange(records.get(i).getDate(), (current - previous) / previous * 100.0);
   }
}
